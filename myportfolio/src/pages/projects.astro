---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";

const projects2=[
	{
		title: "Простой калькулятор.", 
		image: "/project1.jpg"
	},
	{
		title: "Проект 2", 
		image: "/project1.jpg"
	},
	{
		title: "Проект 3", 
		image: "/project1.jpg"
	}
]

---

<Layout>
  <Header />
  <div class="flex flex-col items-center justify-center min-h-screen bg-[#EAE7DC] p-6 text-center">
    <h1 class="text-3xl sm:text-4xl font-caveat text-[#E85A4F] mb-4">
		Проектов пока немного, но коллекция будет пополняться ⟱
	  </h1>	  
	  <Section color="red">
		{projects2.map((data) => <div class="text-center max-w-[150px] sm:max-w-[200px]">
			<img src={data.image} alt="Project 1" class="w-full h-auto object-cover rounded-lg shadow-md" />
			<p class="mt-2 text-sm text-gray-700">{data.title}</p>
		  </div>)}
	  </Section>
	  <a href="https://github.com/DinaTash/full-stack-dev" target="_blank" class="mt-6 text-lg font-semibold text-[#E85A4F] underline hover:text-[#D75A4F]">
		Ссылка на проекты
	  </a>
	</div>
	<Footer />
  </Layout>
  