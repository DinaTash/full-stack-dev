---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Header />
  <div class="flex items-start justify-center h-[80vh] bg-[#EAE7DC] p-6 pt-30">
    <div class="flex flex-col md:flex-row max-w-6xl w-full gap-6 items-start justify-center">
      
      <div class="text-center md:text-left space-y-6 flex flex-col justify-start md:w-1/2 md:max-w-md mx-auto">
        <h1 class="text-4xl sm:text-5xl font-caveat text-[#E85A4F]">Обо мне</h1>
        <p class="text-base sm:text-lg text-[#5C5753] font-sans leading-relaxed">
          Меня зовут Дина. Родилась в Казахстане, на данный момент живу в городе Уральск. 
          По образованию я технолог перерабатывающих производств. Сейчас работаю оператором 
          поддержки и обучаюсь разработке в школе "Owl Masters".
        </p>
      </div>

      <div class="text-center md:text-left flex flex-col justify-start md:w-1/2 bg-[#D8C3A5] p-6 rounded-lg shadow-lg md:max-w-md mx-auto">
        <h2 class="text-3xl sm:text-4xl font-caveat text-[#E85A4F]">Мои увлечения</h2>
        <ul class="text-base sm:text-lg text-[#5C5753] font-sans leading-relaxed list-disc list-inside mx-auto md:mx-0">
          <li>Готовка</li>
          <li>Йога</li>
          <li>Чтение</li>
        </ul>
      </div>

    </div>
  </div>
  <Footer />
</Layout>
