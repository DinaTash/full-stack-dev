---
import Layout from '../layouts/Layout.astro';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

---

<Layout>
  <Header client:load />
  <div class="bg-[#EAE7DC] dark:bg-gray-800 min-h-screen p-4">
    
    <div class="max-w-5xl w-full mt-30 space-y-6 text-center md:text-left md:max-w-2/3 pl-40">
      <h1 class="text-5xl dark:text-white sm:text-6xl font-caveat text-[#E85A4F]">
        Добро пожаловать!
      </h1>
      <p class="text-xl text-[#5C5753] font-sans leading-relaxed">
        Рада видеть вас на моём сайте. Здесь вы можете узнать немного больше обо мне и познакомиться с моей деятельностью.
      </p>
    </div>

  </div>
  <Footer />
</Layout>

